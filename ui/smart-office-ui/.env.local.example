# Smart Office UI local configuration
# Copy the required values into ui/smart-office-ui/.env.local. Do not overwrite an
# existing exhibition configuration without preserving its current camera, vision,
# microphone and display settings.

VITE_API_BASE_URL=http://127.0.0.1:8000

# Keep continuous ASR and Agent TTS on separate Realtime WebRTC sessions. This
# prevents one shared pending response from blocking transcription or speech.
VITE_REALTIME_SEPARATE_SPEECH_SESSION=true

# If server VAD reports speech_started but never reports speech_stopped within this
# period, the UI resets continuous capture and returns to a ready listening state.
VITE_REALTIME_MAX_UTTERANCE_MS=20000
