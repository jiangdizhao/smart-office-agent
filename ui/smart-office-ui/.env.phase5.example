# Smart Office API on the i5 computer
VITE_API_BASE_URL=http://127.0.0.1:8000

# Phase 5 visual source. Production exhibition mode should use remote.
VITE_VISION_SOURCE=remote

# Replace 192.168.1.50 with the fixed LAN IPv4 address of the RTX 3070 Ti laptop.
VITE_VISION_SERVER_HTTP=http://192.168.1.50:8015
VITE_VISION_SERVER_WS=ws://192.168.1.50:8015/ws/v1/events

# Existing greeting master switch.
enable_greet=true

# Exhibition handheld/close-talking microphone settings.
# Leave the device ID empty to use the Windows default input device. For the
# exhibition, set Windows' default input to the dedicated wired/wireless receiver,
# or copy its browser deviceId here after granting microphone permission once.
VITE_PRIMARY_MIC_DEVICE_ID=

# Server VAD defaults tuned conservatively for a close-talking exhibition mic.
# Raise threshold (for example 0.78-0.85) if nearby voices trigger the Agent.
# Lower it (for example 0.62-0.68) if the visitor's voice is missed.
VITE_REALTIME_VAD_THRESHOLD=0.72
VITE_REALTIME_VAD_SILENCE_MS=650
VITE_REALTIME_VAD_PREFIX_MS=420

# Ignore likely loudspeaker echo immediately after Agent playback begins. Raising
# this reduces self-interruption but delays very early visitor barge-in.
VITE_REALTIME_BARGE_IN_GRACE_MS=350

# Optional development mode only:
# VITE_VISION_SOURCE=remote-with-fallback
# Production should not silently fall back to a different browser camera.
