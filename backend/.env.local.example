# Smart Office Backend local configuration
#
# The configured launcher automatically copies this file to backend/.env.local
# when the local file does not exist. backend/.env.local is intentionally ignored
# by Git and may be edited independently on each exhibition computer.
#
# Do not store OPENAI_API_KEY here. The launcher asks for it securely at startup.

# Phase 1 sales experience
SMART_OFFICE_SALES_AGENT_ENABLED=true
SMART_OFFICE_SALES_PROACTIVE_ENABLED=true
SMART_OFFICE_SALES_HUMOUR_ENABLED=true
SMART_OFFICE_SALES_PROFILE_PERSISTENCE_ENABLED=true
SMART_OFFICE_SALES_TELEMETRY_ENABLED=true

# Realtime sales response mode: quality or economy
SMART_OFFICE_REALTIME_MODE=quality

# Phase 2B routing architecture:
#   hybrid  = recommended exhibition default. Deterministic action safety remains,
#             while ordinary non-action conversation fails open to Realtime/Terra.
#   legacy  = emergency rollback to the pre-unified conversation classifier while
#             retaining the deterministic low-risk command grammar.
#   unified = full structured semantic-model routing for test/comparison only.
SMART_OFFICE_ROUTING_ARCHITECTURE=hybrid

# Semantic policy mode remains unified so evidence validation and deterministic
# policy are still enforced for action candidates that reach the semantic router.
# Set shadow only for diagnostic comparison; legacy is not the Phase 2B rollback
# switch (use SMART_OFFICE_ROUTING_ARCHITECTURE=legacy for that).
SMART_OFFICE_SEMANTIC_ROUTER_MODE=unified

# Terra is used only when hybrid routing identifies an action/sales candidate that
# needs structured interpretation, or when the ordinary question is genuinely
# complex. A harmless non-action question never becomes an action clarification
# merely because Terra is slow or returns invalid structured output.
OPENAI_SEMANTIC_ROUTER_MODEL=gpt-5.6-terra

# Presentation resilience. PowerPoint COM runs in a killable worker process on
# Windows so a blocked COM call cannot hold the FastAPI process or later commands.
SMART_OFFICE_POWERPOINT_WORKER_ENABLED=true
# The exhibition computer is dedicated to this demo. On a worker timeout the
# default is to terminate POWERPNT.EXE before starting a clean worker. Set false
# only when unrelated unsaved PowerPoint documents may be open on the same PC.
SMART_OFFICE_POWERPOINT_KILL_ON_WORKER_TIMEOUT=true

# Per-operation PowerPoint deadlines in seconds. Navigation should be fast; open,
# slideshow startup and close are allowed longer because Office may cold-start.
SMART_OFFICE_POWERPOINT_GET_STATUS_TIMEOUT_SECONDS=4
SMART_OFFICE_POWERPOINT_NEXT_SLIDE_TIMEOUT_SECONDS=4
SMART_OFFICE_POWERPOINT_PREVIOUS_SLIDE_TIMEOUT_SECONDS=4
SMART_OFFICE_POWERPOINT_GO_TO_SLIDE_TIMEOUT_SECONDS=4
SMART_OFFICE_POWERPOINT_END_SLIDESHOW_TIMEOUT_SECONDS=8
SMART_OFFICE_POWERPOINT_START_SLIDESHOW_TIMEOUT_SECONDS=10
SMART_OFFICE_POWERPOINT_OPEN_CONFIGURED_TIMEOUT_SECONDS=15
SMART_OFFICE_POWERPOINT_CLOSE_TIMEOUT_SECONDS=10

# Window enumeration invokes Windows tasklist. This subprocess deadline prevents a
# damaged Windows management service from blocking multi-screen placement forever.
SMART_OFFICE_TASKLIST_TIMEOUT_SECONDS=1.5

# Grounded PPT questions fall back to the fixed contact-registration response when
# the model exceeds this exhibition latency budget.
SMART_OFFICE_PRESENTATION_QA_TIMEOUT_SECONDS=10

# Tasks in created/planning/running with no observable progress for this duration
# are cancelled before the frontend's three-minute liveness limit is reached.
SMART_OFFICE_TASK_RUNTIME_TIMEOUT_SECONDS=165
