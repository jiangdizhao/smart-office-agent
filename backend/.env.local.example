# Smart Office Backend local configuration
#
# The configured launcher automatically copies this file to backend/.env.local
# when the local file does not exist. backend/.env.local is intentionally ignored
# by Git and may be edited independently on each exhibition computer.
#
# Do not store OPENAI_API_KEY here. The launcher asks for it securely at startup.

# Phase 1 sales experience
SMART_OFFICE_SALES_AGENT_ENABLED=true
SMART_OFFICE_SALES_PROACTIVE_ENABLED=true
SMART_OFFICE_SALES_HUMOUR_ENABLED=true
SMART_OFFICE_SALES_PROFILE_PERSISTENCE_ENABLED=true
SMART_OFFICE_SALES_TELEMETRY_ENABLED=true

# Realtime sales response mode: quality or economy
SMART_OFFICE_REALTIME_MODE=quality

# Unified semantic routing is the live routing path. The older keyword/regex routes
# remain only for compatibility contracts and optional diagnostic comparison.
SMART_OFFICE_SEMANTIC_ROUTER_MODE=unified

# Terra is used for open-language semantic reasoning. Common exhibition commands,
# identity questions, negation, explanations and application questions are handled
# first by the broad deterministic grammar, so Terra is reserved for genuinely open
# language rather than every short command. Any model failure fails closed.
OPENAI_SEMANTIC_ROUTER_MODEL=gpt-5.6-terra
